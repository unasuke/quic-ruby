module QUIC
  VERSION: String

  # The directory holding quic/ext.h, the C function table other native
  # extensions build against. Defined without loading the extension.
  EXT_INCLUDE_DIR: String

  def self.library_versions: () -> { ngtcp2: String, openssl: String, picotls: String }

  class Error < StandardError
    attr_reader code: Integer?

    class Proto < Error
    end

    class DropConn < Error
    end

    class Retry < Error
    end

    class Closed < Error
    end

    class CryptoError < Error
      # The TLS alert this endpoint sent when the handshake failed in
      # #read_pkt, or nil. Alerts received from the peer are not recorded.
      attr_reader tls_alert: Integer?
    end

    class CertificateVerifyFailed < CryptoError
      # X509_V_ERR_* (comparable with OpenSSL::X509::V_ERR_*), or nil when
      # the server sent no certificate.
      attr_reader verify_result: Integer?
    end

    class HandshakeTimeout < Error
    end

    class FlowControl < Error
    end

    class Unknown < Error
    end

    class WaitReadable < Error
      include IO::WaitReadable
    end

    class WaitWritable < Error
      include IO::WaitWritable
    end

    class StreamClosed < Error
    end

    class StreamReset < Error
    end

    class NotBound < Error
    end

    # Raised by #open_bidi_stream, #open_uni_stream, #accept_stream and
    # #accept_stream_nonblock of a connection whose streams belong to a C
    # stream handler registered through quic/ext.h.
    class InvalidState < Error
    end
  end

  class TransportParams < Data
    attr_reader initial_max_stream_data_bidi_local: Integer
    attr_reader initial_max_stream_data_bidi_remote: Integer
    attr_reader initial_max_stream_data_uni: Integer
    attr_reader initial_max_data: Integer
    attr_reader initial_max_streams_bidi: Integer
    attr_reader initial_max_streams_uni: Integer
    attr_reader max_idle_timeout: Integer
    attr_reader active_connection_id_limit: Integer

    def self.default: () -> TransportParams
  end

  class Settings < Data
    attr_reader cc_algo: Symbol
    attr_reader initial_rtt: Integer
    attr_reader max_window: Integer
    attr_reader max_stream_window: Integer
    attr_reader handshake_timeout: Integer
    attr_reader no_pmtud: bool
    attr_reader alpn: Array[String]

    # Client only: a server does not ask for a client certificate and
    # ignores these three.
    attr_reader verify_mode: :peer | :none
    attr_reader ca_file: (String | _ToPath)?
    attr_reader ca_path: (String | _ToPath)?

    def self.default: () -> Settings
  end

  # A server's certificate chain, private key and ALPN protocols (in order
  # of preference), read once and shared by every connection made from it.
  # A connection keeps the context it started with even after this object
  # is gone. Only .server makes one; a misconfiguration raises
  # ArgumentError naming what could not be loaded or used.
  class TLSContext
    def self.server: (certificate_path: String | _ToPath, private_key_path: String | _ToPath, alpn: Array[String]) -> TLSContext
  end

  module Connection
    # The I/O loop shared by Client and Server. An internal implementation
    # detail: not meant to be included in other classes.
    module Pump
      def bind: (untyped sock) -> self
      def bound_socket: () -> untyped
      def run: () -> void
      def pump_once: (?timeout: Float?) -> void
      def pump_until: () { () -> boolish } -> void

      # Pops the next peer-initiated stream off the accept queue, driving
      # the I/O loop until one arrives. timeout: nil blocks forever
      # (requires #bind), timeout: 0 returns immediately, timeout: Numeric
      # blocks up to that many seconds. Returns nil on timeout. Raises
      # QUIC::Error::InvalidState when a C stream handler owns the streams.
      def accept_stream: (?timeout: Numeric?) -> Stream?

      # Non-blocking #accept_stream. Returns the next queued peer-initiated
      # stream, or raises QUIC::Error::WaitReadable when the queue is empty.
      def accept_stream_nonblock: () -> Stream
    end

    class Client
      include Pump

      attr_reader remote_address: Addrinfo

      def self.new: (host: String, port: Integer, ?address_family: Symbol?, ?transport_params: TransportParams?, ?settings: Settings?) -> Client

      def self._open: (
        local_sockaddr: String,
        remote_sockaddr: String,
        server_name: String,
        transport_params: TransportParams,
        settings: Settings
      ) -> Client

      def open_bidi_stream: () -> Stream
      def open_uni_stream: () -> Stream

      def write_pkt: (?String? buffer) -> String?
      def read_pkt: (String packet, local_sockaddr: String, remote_sockaddr: String) -> nil

      def expiry: () -> Integer?
      def handle_expiry: () -> nil
      def handshake_completed?: () -> bool
      def in_closing_period?: () -> bool
      def in_draining_period?: () -> bool

      # Sends an application CONNECTION_CLOSE (frame type 0x1d) to the peer
      # carrying error_code and reason, then transitions the underlying
      # ngtcp2_conn to the closing period. Requires #bind to have been
      # called; raises QUIC::Error::NotBound otherwise. A second #close call
      # after the connection has already entered the closing or draining
      # period is a no-op.
      def close: (?error_code: Integer, ?reason: String) -> nil

      # Always nil: only a connection an Endpoint made has a closing reason.
      def error: () -> Exception?
    end

    class Server
      include Pump

      attr_reader remote_address: Addrinfo

      # Waits for the first datagram on sock (bound to the listen address,
      # not connected), connects sock to its sender, and returns a Server
      # for that one client; call #run to complete the handshake.
      # - The wait has no timeout; close sock from another thread to give up.
      # - If anything fails after the first datagram arrived, sock stays
      #   connected to its sender: discard it and accept on a new socket.
      # - settings must name at least one ALPN protocol; leaving it out
      #   raises ArgumentError, since QUIC::Settings.default has none.
      # - The certificate file is PEM, the leaf certificate first and then
      #   any intermediates.
      def self.accept: (
        sock: untyped,
        certificate_path: String | _ToPath,
        private_key_path: String | _ToPath,
        ?transport_params: TransportParams?,
        ?settings: Settings?
      ) -> Server

      # Builds a server connection from initial_packet, the first datagram a
      # client sent; feed that datagram to #read_pkt afterwards. The
      # certificate file is PEM, the leaf certificate first and then any
      # intermediates. settings.alpn must not be empty (ArgumentError).
      # A first packet that cannot start a connection raises
      # QUIC::Error::Proto.
      def self._accept: (
        initial_packet: String,
        local_sockaddr: String,
        remote_sockaddr: String,
        certificate_path: String | _ToPath,
        private_key_path: String | _ToPath,
        transport_params: TransportParams,
        settings: Settings
      ) -> Server

      def open_bidi_stream: () -> Stream
      def open_uni_stream: () -> Stream

      def write_pkt: (?String? buffer) -> String?
      def read_pkt: (String packet, local_sockaddr: String, remote_sockaddr: String) -> nil

      def expiry: () -> Integer?
      def handle_expiry: () -> nil
      def handshake_completed?: () -> bool
      def in_closing_period?: () -> bool
      def in_draining_period?: () -> bool

      # Sends an application CONNECTION_CLOSE (frame type 0x1d) to the peer
      # carrying error_code and reason, then transitions the underlying
      # ngtcp2_conn to the closing period. Requires #bind to have been
      # called; raises QUIC::Error::NotBound otherwise. A connection an
      # Endpoint made needs no #bind: the CONNECTION_CLOSE goes out through
      # Endpoint#write_pkt. A second #close call after the connection has
      # already entered the closing or draining period, or after it left
      # its Endpoint, is a no-op.
      def close: (?error_code: Integer, ?reason: String) -> nil

      # Why the Endpoint closed this connection: nil when the peer closed it,
      # it timed out idle or #close was called; the exception itself when
      # Ruby code in a callback raised; otherwise a QUIC::Error made (not
      # raised) from ngtcp2's error code. Always nil for a connection no
      # Endpoint made.
      def error: () -> Exception?
    end
  end

  # Many server connections on one UDP socket, which must not be connected
  # and must be bound to the address it serves. The Endpoint routes each
  # datagram to its connection and makes connections for new clients; the
  # socket and the I/O loop stay with the caller. A connection's failure
  # never raises from these methods; it closes that connection alone (see
  # Connection::Server#error). The connections have no socket, so only their
  # non-blocking methods work.
  class Endpoint
    attr_reader local_address: Addrinfo

    # tls_context's ALPN list is the server's; settings.alpn is not read.
    def self.new: (
      local_address: Addrinfo,
      tls_context: TLSContext,
      ?transport_params: TransportParams?,
      ?settings: Settings?
    ) -> Endpoint

    def self._new: (
      local_sockaddr: String,
      tls_context: TLSContext,
      transport_params: TransportParams,
      settings: Settings
    ) -> Endpoint

    # Routes one datagram from remote (an AF_INET or AF_INET6 sockaddr, as
    # Addrinfo#to_sockaddr makes; ArgumentError otherwise); local defaults
    # to local_address. Returns the connection it went to, which may be a
    # new one, or nil when the Endpoint answered or dropped it.
    def read_pkt: (String packet, remote: String, ?local: String?) -> Connection::Server?

    # The next datagram to send and its destination sockaddr, or nil when
    # there is none left: the Endpoint's own answers first, then each
    # connection's packets in turn.
    def write_pkt: () -> [String, String]?

    # The earliest CLOCK_MONOTONIC time (ns) #handle_expiry is due, or nil.
    def expiry: () -> Integer?

    # Runs the timers that are due and takes out of the table the
    # connections that are finished.
    def handle_expiry: () -> nil

    # The connections that left the table since the last call.
    def take_closed: () -> Array[Connection::Server]

    # The connections in the table, closing and draining ones included.
    def connections: () -> Array[Connection::Server]
  end

  class Stream
    INITIATORS: Array[Symbol]

    attr_reader id: Integer
    alias stream_id id

    def initiator: () -> Symbol
    def read: (?Integer? length) -> String?
    def read_nonblock: (Integer length) -> String

    # Blocks (by internally calling #pump_once on the owning Client or
    # Server) until the peer's flow control window has room for the full
    # payload, then queues all bytes and returns data.bytesize. Requires the
    # owning connection to be bound to a socket via #bind; raises
    # QUIC::Error::NotBound otherwise.
    def write: (String data, ?fin: bool) -> Integer

    # Non-blocking variant. Queues as much of `data` as the current flow
    # control window allows and returns the byte count actually queued.
    # Raises QUIC::Error::WaitWritable (mixed in with IO::WaitWritable) when
    # the window is zero and the payload is non-empty. If only a partial
    # prefix is accepted, `fin: true` is NOT propagated; the caller must
    # re-issue with `fin: true` on the trailing chunk.
    def write_nonblock: (String data, ?fin: bool) -> Integer
    def eof?: () -> bool

    # True once the stream is fully closed: both directions have finished
    # (FIN or reset) and everything sent has been acknowledged. Stays false
    # if the connection closes first, since ngtcp2 does not report stream
    # closure then. Keeps returning true after the stream has left the
    # connection. A bare Stream is never closed.
    def closed?: () -> bool

    def close_write: () -> nil
    def close_read: () -> nil
    def close: () -> nil

    # Aborts the send side with RESET_STREAM carrying error_code (default 0).
    # After #reset, #write / #write_nonblock raise QUIC::Error::StreamClosed.
    # The read side is unaffected. Idempotent: a second #reset is a no-op.
    def reset: (?Integer error_code) -> nil
  end
end
